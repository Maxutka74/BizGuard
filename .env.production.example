# Copy to .env.production and replace every CHANGE_ME value.
POSTGRES_DB=bizguard
POSTGRES_USER=bizguard
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD

DJANGO_SECRET_KEY=CHANGE_ME_LONG_RANDOM_DJANGO_SECRET
LICENSE_KEY_HASH_SECRET=CHANGE_ME_LONG_RANDOM_HASH_SECRET
BILLING_LICENSE_ENCRYPTION_SECRET=CHANGE_ME_LONG_RANDOM_ENCRYPTION_SECRET
ALLOWED_HOSTS=app.example.com,buy.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com,https://buy.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com,https://buy.example.com

GOOGLE_OAUTH_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=CHANGE_ME
GOOGLE_OAUTH_REDIRECT_URI=https://app.example.com/auth/callback
GOOGLE_PUBLIC_OAUTH_REDIRECT_URI=https://api.example.com/api/accounts/google/public-redirect

VIRUSTOTAL_API_KEY=CHANGE_ME
STRIPE_SECRET_KEY=CHANGE_ME
BILLING_FAKE_MODE=False

BIZGUARD_APP_URL=https://app.example.com
PURCHASE_SITE_URL=https://buy.example.com
BIZGUARD_APP_HOST_PORT=8080
PURCHASE_SITE_HOST_PORT=8081

AI_PROVIDER_ORDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:1.5b
CELERY_WORKER_CONCURRENCY=4
CELERY_AI_WORKER_CONCURRENCY=2
