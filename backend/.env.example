# Django (development defaults)
DJANGO_SECRET_KEY=change-this-development-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174
API_DOCS_ENABLED=True

# Internal Docker services
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/bizguard
REDIS_URL=redis://redis:6379/0

# Google OAuth / Gmail
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/auth/callback
GOOGLE_PUBLIC_OAUTH_REDIRECT_URI=http://localhost:8000/api/accounts/google/public-redirect

# License and billing security
LICENSE_KEY_HASH_SECRET=change-this-license-hash-secret
BILLING_LICENSE_ENCRYPTION_SECRET=change-this-independent-encryption-secret
BILLING_FAKE_MODE=True
STRIPE_SECRET_KEY=
PURCHASE_SITE_URL=http://localhost:5174
BIZGUARD_APP_URL=http://localhost:5173

# AI worker / Ollama
AI_PROVIDER_ORDER=ollama
AI_MESSAGE_TIME_BUDGET_SECONDS=30
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_DISABLE_ON_ERROR_SECONDS=30
OLLAMA_MODEL_CHECK_SECONDS=60
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=480
OLLAMA_KEEP_ALIVE=10m
CELERY_WORKER_CONCURRENCY=4
CELERY_AI_WORKER_CONCURRENCY=2

# VirusTotal
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_DISABLE_ON_RATE_LIMIT_SECONDS=900
