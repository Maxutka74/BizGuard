DJANGO_SECRET_KEY=bizguard-dev-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/bizguard
REDIS_URL=redis://redis:6379/0

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/auth/callback

AI_PROVIDER_ORDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_DISABLE_ON_ERROR_SECONDS=30
OLLAMA_PULL_ON_START=true
OLLAMA_MODEL_CHECK_SECONDS=60
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=480
OLLAMA_KEEP_ALIVE=10m
CELERY_WORKER_CONCURRENCY=4

VIRUSTOTAL_API_KEY=
VIRUSTOTAL_DISABLE_ON_RATE_LIMIT_SECONDS=900
